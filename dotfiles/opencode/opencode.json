{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "obsidian": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mauricio.wolff/mcp-obsidian@latest",
          "{env:OBSIDIAN_VAULT_PATH}"
        ]
      },
      "onesignal_staging": {
        "type": "remote",
        "url": "https://api.staging.onesignal.com/mcp/oauth"
      },
      "onesignal_production": {
        "type": "remote",
        "url": "https://api.onesignal.com/mcp/oauth"
      }
    }
  },
  "permissions": [
    { "action": "linear_*", "resource": "*", "effect": "deny" },
    { "action": "obsidian_*", "resource": "*", "effect": "deny" }
  ]
}
